<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:VisualElement name="StartScreenContainer" style="flex-grow: 1; opacity: 1; position: absolute; top: 0; right: 0; bottom: 0; left: 0; background-color: rgb(0, 0, 0); transition-property: opacity; transition-duration: 1s; justify-content: center; align-self: auto; align-items: center; background-image: url(&quot;project://database/Assets/_2DAdventureGame/Tutorial_Demo/Demo_Art/Common/Background.png?fileID=2800000&amp;guid=45466ef8ed5f0fa4a94d9de87febf418&amp;type=3#Background&quot;); -unity-background-scale-mode: scale-and-crop;">
        <ui:Label text="Robot Factory Repair" name="Name" style="font-size: 46px; -unity-font-style: bold; color: rgb(238, 238, 238);"/>
        <ui:Label text="Goal: Repair all the broken robots and avoid the traps!" name="Goal" style="font-size: 26px; color: rgb(255, 255, 255); white-space: normal;"/>
        <ui:Button text="Play" name="StartButton" style="font-size: 35px; margin-top: 10px; margin-right: 30px; margin-bottom: 10px; margin-left: 30px; padding-left: 60px; padding-right: 60px; padding-top: 20px; padding-bottom: 20px; align-self: auto; align-content: auto; justify-content: flex-start; top: 12%; align-items: center;"/>
        <ui:Button text="Exit" name="ExitButton" style="font-size: 35px; margin-top: 10px; margin-right: 30px; margin-bottom: 10px; margin-left: 30px; padding-left: 60px; padding-right: 60px; padding-top: 20px; padding-bottom: 20px; align-self: auto; align-content: auto; justify-content: flex-start; top: 12%; align-items: center;"/>
    </ui:VisualElement>
    <ui:VisualElement name="FadeOverlay" picking-mode="Ignore" style="position: absolute; top: 0; right: 0; bottom: 0; left: 0; background-color: rgb(0, 0, 0); opacity: 0;"/>
</ui:UXML>
