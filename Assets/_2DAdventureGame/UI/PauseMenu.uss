.pause-title {
    font-size: 50px;
    -unity-font-style: bold;
    letter-spacing: 5px;
    color: rgb(255, 190, 70);
    -unity-text-align: middle-center;
    text-shadow: 0px 4px 10px rgba(0, 0, 0, 0.9);
    margin-bottom: 40px;
}

.pause-button {
    width: 280px;
    height: 60px;
    margin-top: 10px;
    margin-bottom: 10px;

    font-size: 24px;
    -unity-font-style: bold;
    letter-spacing: 2px;
    color: rgb(240, 245, 250);
    -unity-text-align: middle-center;

    background-color: rgba(30, 30, 30, 0.95);
    border-width: 2px;
    border-color: rgb(150, 150, 150);
    border-radius: 6px;

    transition-property: background-color, border-color, scale;
    transition-duration: 0.1s;
}

.pause-button:hover {
    background-color: rgb(60, 60, 60);
    border-color: rgb(255, 255, 255);
    scale: 1.05 1.05;
}
.pause-button:active {
    scale: 0.95 0.95;
}

.pause-button-danger {
    border-color: rgb(200, 60, 60);
}
.pause-button-danger:hover {
    background-color: rgb(120, 40, 40);
    border-color: rgb(255, 100, 100);
}
